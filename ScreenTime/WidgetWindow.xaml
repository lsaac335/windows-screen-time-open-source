<Window x:Class="ScreenTime.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTime"
        Title="屏幕时间 · 桌面组件" Width="360" Height="350"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="WidgetIconButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
                <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource GlassControl}"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            </Style>
            <Style x:Key="WidgetMenu" TargetType="ContextMenu">
                <Setter Property="Width" Value="184"/><Setter Property="Padding" Value="5"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="WidgetMenuItem" TargetType="MenuItem">
                <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,7"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardAltBackground}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="WidgetMenuSeparator" TargetType="Separator">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="7,4" Background="{DynamicResource Line}"/></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
      <Border Margin="8" CornerRadius="22" Background="{DynamicResource GlassDepth}" IsHitTestVisible="False">
          <Border.Effect><DropShadowEffect Color="#171020" BlurRadius="14" ShadowDepth="3" Opacity="0.7"/></Border.Effect>
      </Border>
      <Border x:Name="WidgetCard" Margin="8" CornerRadius="22"
            Background="{DynamicResource GlassWidget}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove"
            MouseLeftButtonUp="Card_MouseLeftButtonUp" LostMouseCapture="Card_LostMouseCapture">
        <Grid>
          <Border Style="{StaticResource GlassHighlight}" CornerRadius="18"/>
          <Grid Margin="18,14,18,13">
            <Grid.RowDefinitions>
                <RowDefinition Height="29"/><RowDefinition Height="104"/><RowDefinition Height="81"/>
                <RowDefinition Height="*"/><RowDefinition Height="29"/>
            </Grid.RowDefinitions>
            <Grid ToolTip="拖动移动 · 双击打开完整面板">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentFill}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="2" Height="5" CornerRadius="1" Background="White" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                        <Border Width="2" Height="12" CornerRadius="1" Background="White" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                        <Border Width="2" Height="8" CornerRadius="1" Background="White" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock Text="屏幕时间" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WidgetDate" FontSize="12" Foreground="{DynamicResource Muted}" Margin="9,0,0,0"/>
                    <TextBlock x:Name="LockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Muted}" Margin="7,1,0,0" Visibility="Collapsed" ToolTip="位置已锁定"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="3,0,-3,0">
                    <Button Content="&#xE8A7;" Style="{StaticResource WidgetIconButton}" Click="OpenDashboard_Click" ToolTip="打开完整面板" AutomationProperties.Name="打开完整面板"/>
                    <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource WidgetIconButton}" Click="More_Click" ToolTip="组件选项" AutomationProperties.Name="组件选项"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource GlassHero}" BorderBrush="{DynamicResource GlassEdge}"
                    BorderThickness="1" CornerRadius="14" Margin="0,4,0,4" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" ToolTip="活跃时长按空闲规则估算，不含屏幕时间自身。">
                        <TextBlock Text="今日活跃" FontSize="12" Foreground="{DynamicResource Muted}"/>
                        <TextBlock x:Name="WidgetForeground" Text="—" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="35" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentText}" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="亮屏 " FontSize="12" Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="WidgetScreen" Text="—" FontSize="12" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource Secondary}" Margin="3,0"/>
                            <TextBlock x:Name="WidgetRawForeground" Text="前台 —" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <local:ActivityRing x:Name="WidgetRing" Grid.Column="1" Width="73" Height="73"
                                        AutomationProperties.Name="活跃时长占亮屏时长 —" ToolTip="活跃时长占今日亮屏时长的比例"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,1,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="分时使用" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="8" Height="8" CornerRadius="1" BorderBrush="{DynamicResource ChartScreenStroke}" BorderThickness="1" Margin="0,0,4,0"/>
                        <TextBlock Text="亮屏" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource ChartForeground}" Margin="0,0,4,0"/>
                        <TextBlock Text="活跃" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <Button x:Name="WidgetChartDetailsButton" Content="数据明细" Style="{StaticResource RoundButton}" Click="ChartDetails_Click"
                                Margin="8,0,0,0" Padding="7,3" FontSize="11" AutomationProperties.Name="查看今日分时数据明细"/>
                    </StackPanel>
                </Grid>
                <local:UsageChart x:Name="WidgetChart" Grid.Row="1" Margin="0,1,0,0"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,5,0,6">
                <StackPanel x:Name="WidgetApps"/>
                <TextBlock x:Name="WidgetEmpty" Text="切换软件后，常用应用会显示在这里" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <Grid Grid.Row="4" Margin="0,3,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Background="{DynamicResource Line}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="WidgetStatusDot" Width="5" Height="5" Fill="{DynamicResource StatusGood}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="WidgetStatus" Text="正在记录" FontSize="12" Foreground="{DynamicResource Muted}" MaxWidth="152" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="WidgetMode" FontSize="11" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,10,0"/>
                <Button Grid.Column="2" x:Name="WidgetPause" Content="暂停" Style="{StaticResource RoundButton}" FontSize="12" Padding="10,3" Height="26" Click="Pause_Click" ToolTip="暂停记录" AutomationProperties.Name="暂停记录"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
</Window>
