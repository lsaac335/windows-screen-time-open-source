<Window x:Class="ScreenTime.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenTime"
        Title="屏幕时间 · 桌面组件" Width="320" Height="306"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="WidgetGhostBtn" TargetType="Button">
                <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource Secondary}"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="WidgetMenu" TargetType="ContextMenu">
                <Setter Property="Width" Value="184"/><Setter Property="Padding" Value="5"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="WidgetMenuItem" TargetType="MenuItem">
                <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,7"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="WidgetMenuSeparator" TargetType="Separator">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="7,4" Background="{DynamicResource Line}"/></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Border Margin="10" CornerRadius="20" Background="{DynamicResource GlassWidget}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="#080B14" BlurRadius="16" ShadowDepth="4" Opacity="0.28"/></Border.Effect>
        </Border>
        <Border x:Name="WidgetCard" Margin="10" CornerRadius="20"
                Background="{DynamicResource GlassWidget}" BorderBrush="{DynamicResource GlassCardEdge}" BorderThickness="1"
                MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove"
                MouseLeftButtonUp="Card_MouseLeftButtonUp" LostMouseCapture="Card_LostMouseCapture">
            <Grid Margin="18,14,18,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid ToolTip="拖动移动 · 双击打开主面板">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="屏幕时间" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="位置已锁定"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="WidgetDate" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="&#xE8A7;" Style="{StaticResource WidgetGhostBtn}" Click="OpenDashboard_Click" ToolTip="打开完整面板" AutomationProperties.Name="打开完整面板"/>
                        <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource WidgetGhostBtn}" Click="More_Click" ToolTip="组件选项" AutomationProperties.Name="组件选项"/>
                    </StackPanel>
                </Grid>

                <!-- Inner Minimalist Hero Box (Matches Mockup) -->
                <Border Grid.Row="1" Background="{DynamicResource GlassHero}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Margin="0,10,0,8" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="今日活跃" FontSize="11.5" Foreground="{DynamicResource Muted}"/>
                            <TextBlock x:Name="WidgetForeground" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" FontSize="29" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentText}" Margin="0,1,0,0"/>
                            <TextBlock x:Name="WidgetScreen" Visibility="Collapsed"/>
                            <TextBlock x:Name="WidgetRawForeground" Visibility="Collapsed"/>
                        </StackPanel>
                        <Border x:Name="WidgetPctBadge" Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="11,6" VerticalAlignment="Center"
                                ToolTip="活跃时长占今日亮屏时长的比例">
                            <TextBlock x:Name="WidgetPctText" Text="—" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Typography.NumeralAlignment="Tabular"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Pure Floating Capsule Bars (No Axes, No Stripes) -->
                <local:UsageChart x:Name="WidgetChart" Grid.Row="2" CompactWidgetMode="True" Margin="0,2,0,6"/>

                <!-- Clean Top 2 Apps List -->
                <Grid Grid.Row="3" VerticalAlignment="Center">
                    <StackPanel x:Name="WidgetApps"/>
                    <TextBlock x:Name="WidgetEmpty" Text="切换软件后，常用应用会显示在这里" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>

                <!-- Minimal Footer -->
                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="WidgetStatusDot" Width="5" Height="5" Fill="{DynamicResource StatusGood}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="WidgetStatus" Text="正在记录" FontSize="11" Foreground="{DynamicResource Muted}" MaxWidth="165" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WidgetMode" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="WidgetPause" Content="暂停" Style="{StaticResource WidgetGhostBtn}" Width="Auto" Height="20" Padding="8,0"
                            FontFamily="Microsoft YaHei UI" FontSize="11.5" Foreground="{DynamicResource Accent}" Click="Pause_Click" ToolTip="暂停记录" AutomationProperties.Name="暂停记录"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
