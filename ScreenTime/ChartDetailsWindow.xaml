<Window x:Class="ScreenTime.ChartDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="530" MinWidth="330" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" Content="关闭" IsCancel="True" Style="{StaticResource RoundButton}"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
        <ListBox x:Name="Periods" AutomationProperties.Name="使用时间明细" FontSize="13"
                 Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}"
                 BorderBrush="{DynamicResource Line}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBar}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                    <Setter Property="Padding" Value="9,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Background="Transparent" BorderThickness="2"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
