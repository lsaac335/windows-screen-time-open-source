<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Ink" Color="#EDF1FA"/>
    <SolidColorBrush x:Key="Muted" Color="#A1AEC5"/>
    <SolidColorBrush x:Key="Accent" Color="#A19BFF"/>
    <SolidColorBrush x:Key="Line" Color="#2D394E"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#111620"/>
    <SolidColorBrush x:Key="CardBackground" Color="#1B2331"/>
    <SolidColorBrush x:Key="CardAltBackground" Color="#202A3B"/>
    <SolidColorBrush x:Key="Secondary" Color="#7989A5"/>
    <SolidColorBrush x:Key="AccentFill" Color="#665DE0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#302E52"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0C111B"/>
    <SolidColorBrush x:Key="SidebarCardBackground" Color="#1C263B"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#29334B"/>
    <SolidColorBrush x:Key="SidebarMuted" Color="#9AA8C2"/>
    <SolidColorBrush x:Key="StatusGood" Color="#6DD6B1"/>
    <SolidColorBrush x:Key="StatusGoodBackground" Color="#183A33"/>
    <SolidColorBrush x:Key="StatusWarning" Color="#F3B77B"/>
    <SolidColorBrush x:Key="StatusWarningBackground" Color="#412E23"/>
    <SolidColorBrush x:Key="StatusIdleBackground" Color="#283144"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#D8D4FF"/>
    <SolidColorBrush x:Key="InputBackground" Color="#151D2A"/>
    <SolidColorBrush x:Key="Danger" Color="#F19393"/>
    <SolidColorBrush x:Key="CaptionHover" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="CaptionPressed" Color="#24FFFFFF"/>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style TargetType="Button" x:Key="RoundButton">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.6"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource RoundButton}">
        <Setter Property="Background" Value="{DynamicResource AccentFill}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource RoundButton}">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="11,8"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="{DynamicResource CardAltBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Track" Background="{DynamicResource Line}" CornerRadius="11" Width="40" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/></Border>
          <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFill}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DatePicker"><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
    <Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/></Style>
    <Style TargetType="Calendar"><Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
</ResourceDictionary>
